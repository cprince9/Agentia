# ==============================================================================
# MASDS Environment Configuration Template
# Copy this file to .env and provide your specific credentials
# ==============================================================================

# LLM API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=

# PostgreSQL Database Configuration
POSTGRES_USER=masds
POSTGRES_PASSWORD=masds
POSTGRES_DB=masds
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://masds:masds@postgres:5432/masds

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ChromaDB Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# MinIO Object Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=masds-artifacts
MINIO_SECURE=false

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
